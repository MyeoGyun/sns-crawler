# Twitter/X 쿠키 설정
#
# 쿠키 추출 방법:
# 1. Chrome에서 twitter.com 또는 x.com 로그인
# 2. F12 (개발자 도구) 열기
# 3. Application 탭 → Cookies → https://x.com
# 4. 아래 쿠키 값들을 복사하여 붙여넣기
#
# 주의: 이 파일을 다른 사람과 공유하지 마세요!

# 필수 쿠키 (로그인 유지에 필요)
AUTH_TOKEN=your_auth_token_here
CT0=your_ct0_csrf_token_here

# 선택 쿠키 (있으면 더 안정적)
TWID=your_twid_here
GUEST_ID=your_guest_id_here

# 전체 쿠키 JSON (선택사항 - 위 개별 쿠키 대신 사용 가능)
# Chrome 개발자도구 > Application > Cookies > 우클릭 > Copy all as JSON
# 아래 형식으로 한 줄로 작성:
# COOKIES_JSON=[{"name":"auth_token","value":"xxx","domain":".x.com"},{"name":"ct0","value":"yyy","domain":".x.com"}]

COOKIES_JSON=
